# 02-auth-flows — environment variables.
#
# All three paths share CANVUS_BASE_URL. Provide the optional credentials
# for whichever paths you want exercised; missing paths are skipped with a
# warning, not a hard failure.

# Required for all paths.
CANVUS_BASE_URL=https://dev-mtcs.multitaction.com/api/v1/

# Path 1 — API key. Skipped if unset.
CANVUS_API_KEY=replace-me-with-an-api-key

# Path 2 — Email + password login. Skipped if either is unset.
# Path 3 (access-token CRUD) requires Path 2 to succeed because it operates
# on the logged-in user's tokens.
CANVUS_EMAIL=user@example.com
CANVUS_PASSWORD=super-secret-password

# Optional: "json" or "text" (default).
LOG_FORMAT=text
