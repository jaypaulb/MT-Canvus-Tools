# 04-file-upload — environment variables.

# Required.
CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=replace-me-with-an-api-key

# Optional: target canvas. If unset, the program picks the first canvas the
# API key has rw access to.
CANVUS_CANVAS_ID=

# Optional: path to the image to upload. Defaults to ./sample.png; if that
# file doesn't exist, a 256x256 MT-blue PNG is generated on the fly.
CANVUS_IMAGE_PATH=

# Optional: set to "1" to leave the uploaded image on the canvas; otherwise
# the program deletes it on exit (defer) for a clean campsite.
CANVUS_KEEP_WIDGET=

# Optional: "json" or "text" (default).
LOG_FORMAT=text
