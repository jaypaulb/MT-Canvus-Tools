# 01-auth-and-list — required environment variables.
#
# Copy this file to .env and fill in the values, then `source .env` (or use
# direnv) before running `go run .`.

# Canvus API base URL. Include the trailing /api/v1/ — the SDK appends paths
# relative to this URL.
CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/

# Long-lived API key (Private-Token header). Mint one from the Canvus UI under
# Settings -> Access Tokens.
CANVUS_API_KEY=replace-me-with-a-real-api-key

# Optional: "json" or "text" (default). JSON is recommended for production
# log aggregation; text is human-readable for local development.
LOG_FORMAT=text
