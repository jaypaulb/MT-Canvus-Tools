# 03-widget-crud — environment variables.

# Required: full base URL including /api/v1/.
CANVUS_BASE_URL=https://dev-mtcs.multitaction.com/api/v1/

# Required: API key with write access on the target canvas.
CANVUS_API_KEY=replace-me-with-an-api-key

# Required: ID of an existing canvas the API key can write to.
# (Run example 01 first to discover canvas IDs.)
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Optional: "json" or "text" (default).
LOG_FORMAT=text
