# 05-streaming — environment variables.

CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=replace-me-with-an-api-key

# Required: canvas to subscribe to. The principal must have read access.
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Optional: how long to keep the stream open before clean shutdown.
# Default: 30 seconds. SIGINT/Ctrl-C also exits cleanly.
STREAM_DURATION_SECONDS=30

# Optional: "json" or "text" (default).
LOG_FORMAT=text
