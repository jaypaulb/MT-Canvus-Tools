# 08-cross-canvas-clone — environment variables.

CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=replace-me-with-an-api-key

# Required: source and destination canvas UUIDs.
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000
CANVUS_DEST_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Required: ID of the widget on CANVUS_CANVAS_ID to clone.
CANVUS_SOURCE_WIDGET_ID=00000000-0000-0000-0000-000000000000

# Optional: set to "1" to delete the cloned widget 2 seconds after creation
# (useful for repeated test runs that shouldn't leave artefacts).
CANVUS_CLEANUP=

# Optional: "json" or "text" (default).
LOG_FORMAT=text
