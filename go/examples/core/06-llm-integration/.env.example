# 06-llm-integration — environment variables.

CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=replace-me-with-an-api-key

# Required for the watcher: the canvas to watch.
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Ollama configuration. Defaults below match a local Ollama default install.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: "json" or "text" (default).
LOG_FORMAT=text
