# 07-webhooks-notifications — environment variables.

CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=replace-me-with-an-api-key

# Required: canvas whose widget creations should be forwarded.
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Required: webhook receiver. For testing, grab a one-shot URL from
# https://webhook.site/ and paste it here.
WEBHOOK_URL=https://webhook.site/your-unique-id

# Optional: "json" or "text" (default).
LOG_FORMAT=text
