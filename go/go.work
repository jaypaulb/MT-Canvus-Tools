go 1.24.0

use (
	./cli
	./examples/core/01-auth-and-list
	./examples/core/02-auth-flows
	./examples/core/03-widget-crud
	./examples/core/04-file-upload
	./examples/core/05-streaming
	./examples/core/06-llm-integration
	./examples/core/07-webhooks-notifications
	./examples/core/08-cross-canvas-clone
	./examples/projects/ai-personas
	./examples/projects/llm-canvas-companion
	./examples/projects/note-mapper
	./internal/llm
	./sdk
	./tools/db-solver
	./tools/powertoys
	./tools/translator
)

// Each example's go.mod requires the SDK with a placeholder version
// (`v0.0.0-00010101000000-000000000000`) so that `go test` in workspace mode
// has a concrete version to substitute. This replace points that placeholder
// at the in-tree sdk module so the resolver doesn't reach for the module
// proxy.
replace github.com/jaypaulb/MT-Canvus-Tools/go/sdk v0.0.0-00010101000000-000000000000 => ./sdk

// The shared LLM helper at ./internal/llm is referenced by consumers via a
// placeholder version (matching the SDK pattern) so workspace builds resolve
// to the in-tree module without going to the module proxy.
replace github.com/jaypaulb/MT-Canvus-Tools/go/internal/llm v0.0.0-00010101000000-000000000000 => ./internal/llm
