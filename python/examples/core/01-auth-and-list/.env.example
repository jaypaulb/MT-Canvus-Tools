# Example 01 — auth-and-list
# Copy to .env and fill in real values.

# Base URL of the Canvus server. Trailing /api/v1/ is optional.
CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/

# Long-lived API token (Private-Token header).
CANVUS_API_KEY=ck_replace_me

# Optional logging controls (see Python SDK conventions).
LOG_FORMAT=console
LOG_LEVEL=INFO
