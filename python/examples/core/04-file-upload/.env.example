CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=ck_replace_me
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Optional: path to a local PNG. If unset (or invalid) the example
# generates a 256x256 solid-colour PNG using only the stdlib.
# CANVUS_IMAGE_PATH=./sample.png

# Optional: set to "1" to leave the uploaded image on the canvas.
# CANVUS_KEEP_WIDGET=1

LOG_FORMAT=console
LOG_LEVEL=INFO
