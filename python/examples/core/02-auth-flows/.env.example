# Example 02 — auth-flows
# Set any subset of the three flows below; absent flows are skipped, not failed.

CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/

# Flow 1: API key path (also drives flow 3's programmatic token lifecycle).
CANVUS_API_KEY=ck_replace_me

# Flow 2: email + password login. Send ONLY `email` — do not also send
# `username`, which the live server rejects (VERIFIED-CORRECTIONS.md §4).
CANVUS_EMAIL=you@example.com
CANVUS_PASSWORD=correct-horse-battery-staple

LOG_FORMAT=console
LOG_LEVEL=INFO
