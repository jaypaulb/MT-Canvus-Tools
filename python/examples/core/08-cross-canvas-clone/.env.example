CANVUS_API_URL=https://dev-mtcs.multitaction.com/api/v1/
CANVUS_API_KEY=ck_replace_me

# Source canvas (contains the widget to clone).
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000
# Widget id to clone FROM the source canvas.
CANVUS_SOURCE_WIDGET_ID=00000000-0000-0000-0000-000000000000
# Destination canvas (where the clone will be created). Must have edit access.
CANVUS_DEST_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Set to "1" to delete the cloned widget 2 s after creation.
# CANVUS_CLEANUP=1

LOG_FORMAT=console
LOG_LEVEL=INFO
