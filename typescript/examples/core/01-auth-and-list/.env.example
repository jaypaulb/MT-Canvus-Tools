# Base URL of the Canvus API, including trailing slash.
# Example: https://canvus.example.com/api/v1/
CANVUS_API_URL=https://canvus.example.com/api/v1/

# Long-lived API key sent in the `Private-Token` header.
CANVUS_API_KEY=replace-me

# Optional: pino log level (default: info)
# LOG_LEVEL=debug

# Optional: pino transport. Set to `pretty` for human-readable dev output.
# LOG_FORMAT=pretty
