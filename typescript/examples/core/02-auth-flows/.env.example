# Required for mode 1 (API key) and mode 3 (access-token CRUD via the
# logged-in session — see CANVUS_EMAIL/CANVUS_PASSWORD).
CANVUS_BASE_URL=https://canvus.example.com/api/v1/
CANVUS_API_KEY=replace-me

# Optional — required for mode 2 (login) and mode 3 (token lifecycle).
# CANVUS_EMAIL=alice@example.com
# CANVUS_PASSWORD=replace-me

# LOG_LEVEL=debug
# LOG_FORMAT=pretty
