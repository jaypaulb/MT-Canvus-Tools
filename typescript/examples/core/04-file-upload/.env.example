CANVUS_API_URL=https://canvus.example.com/api/v1/
CANVUS_API_KEY=replace-me
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Optional: path to your own PNG. If omitted, an embedded 16x16 blue
# sample PNG is uploaded instead.
# CANVUS_IMAGE_PATH=./sample.png

# Optional: set to 1 to leave the uploaded widget on the canvas after
# the example finishes. Default (0) deletes the widget for cleanup.
# CANVUS_KEEP_WIDGET=1

# LOG_LEVEL=debug
# LOG_FORMAT=pretty
