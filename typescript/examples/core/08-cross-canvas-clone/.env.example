CANVUS_API_URL=https://canvus.example.com/api/v1/
CANVUS_API_KEY=replace-me

# Source canvas + widget to clone FROM. Key needs at least view access.
CANVUS_CANVAS_ID=00000000-0000-0000-0000-000000000000
CANVUS_SOURCE_WIDGET_ID=00000000-0000-0000-0000-000000000000

# Destination canvas. Key needs edit access.
CANVUS_DEST_CANVAS_ID=00000000-0000-0000-0000-000000000000

# Set to 1 to delete the cloned widget after a 2-second pause. Default 0.
# CANVUS_CLEANUP=1

# LOG_LEVEL=debug
# LOG_FORMAT=pretty
