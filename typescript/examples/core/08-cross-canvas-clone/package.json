{
  "name": "@mt-canvus-tools/example-cross-canvas-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Clone a widget from one canvas to another via the standard create endpoint with source-canvas-id / source-widget-id.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mt-canvus-tools/sdk": "workspace:*",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
